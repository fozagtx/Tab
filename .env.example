# Public
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server — required for Supabase writes (omit to use local .data/ JSON store)
SUPABASE_SERVICE_ROLE_KEY=

# Network: testnet (default) | mainnet
NEXT_PUBLIC_NIMIQ_NETWORK=testnet

# Optional JSON-RPC override. Testnet uses nimiq.watch history API by default.
# Mainnet default if unset: https://rpc.nimiqwatch.com
# NIMIQ_RPC_URL=

# Canonical URL for Open Graph (set to your Vercel URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
